# Copy to .nodeforge/env and fill real values. Do NOT commit .nodeforge/env.
NODE_SECRET_ENCRYPTION_KEY=replace-with-base64-32bytes
# Canonical Node Control persistence root (relative to the project root)
NODE_CONTROL_DATA_DIR=.forge/runtime/nf
# Optional: overrides for Control API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://sv.devquote.shop
NODE_AGENT_MODEL=gpt-5.6-terra
