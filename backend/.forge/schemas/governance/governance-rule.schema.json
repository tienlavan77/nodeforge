{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/governance/governance-rule.schema.json",
  "title": "Forge Governance Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "trigger", "condition", "enforcement", "severity"],
  "properties": {
    "id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "trigger": { "type": "string", "minLength": 1 },
    "condition": { "type": "object", "minProperties": 1, "additionalProperties": true },
    "enforcement": { "type": "string", "enum": ["blocking", "orchestrator", "review"] },
    "severity": { "$ref": "../core/common.schema.json#/$defs/severity" },
    "enabled": { "type": "boolean", "default": true }
  }
}
