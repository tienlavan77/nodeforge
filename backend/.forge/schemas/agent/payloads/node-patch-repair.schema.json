{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/node-patch-repair.schema.json",
  "title": "Forge Node Patch Repair Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "repair_id",
    "attempt",
    "max_attempts",
    "approved_plan_ref",
    "invalid_patches",
    "expected_output"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repair_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "approved_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "invalid_patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "before_checksum",
              "current_content",
              "error"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "full_content"
              },
              "before_checksum": {
                "type": "null"
              },
              "current_content": {
                "type": "null"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PATCH_CONTEXT_NOT_FOUND",
                      "PATCH_CONTEXT_AMBIGUOUS",
                      "CHECKSUM_MISMATCH",
                      "SYNTAX_ERROR",
                      "VALIDATION_ERROR",
                      "INVALID_PAYLOAD"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "before_checksum",
              "current_content",
              "error"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "structured_patch"
              },
              "before_checksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "current_content": {
                "type": "string"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PATCH_CONTEXT_NOT_FOUND",
                      "PATCH_CONTEXT_AMBIGUOUS",
                      "CHECKSUM_MISMATCH",
                      "SYNTAX_ERROR",
                      "VALIDATION_ERROR",
                      "INVALID_PAYLOAD"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "before_checksum",
              "current_content",
              "error"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "apply_patch"
              },
              "before_checksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "current_content": {
                "type": "string"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PATCH_CONTEXT_NOT_FOUND",
                      "PATCH_CONTEXT_AMBIGUOUS",
                      "CHECKSUM_MISMATCH",
                      "SYNTAX_ERROR",
                      "VALIDATION_ERROR",
                      "INVALID_PAYLOAD"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "before_checksum",
              "current_content",
              "error"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "unified_diff"
              },
              "before_checksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "current_content": {
                "type": "string"
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PATCH_CONTEXT_NOT_FOUND",
                      "PATCH_CONTEXT_AMBIGUOUS",
                      "CHECKSUM_MISMATCH",
                      "SYNTAX_ERROR",
                      "VALIDATION_ERROR",
                      "INVALID_PAYLOAD"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        ]
      }
    },
    "expected_output": {
      "const": {
        "type": "patch_repair_response",
        "transport": "function_tool"
      }
    }
  },
  "$defs": {
    "structured_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/replace_range"
              },
              {
                "$ref": "#/$defs/delete_range"
              },
              {
                "$ref": "#/$defs/insert_after"
              },
              {
                "$ref": "#/$defs/insert_at_end"
              }
            ]
          }
        }
      }
    },
    "replace_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "expected_content",
        "new_content"
      ],
      "properties": {
        "op": {
          "const": "replace_range"
        },
        "expected_content": {
          "type": "string",
          "minLength": 1
        },
        "new_content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delete_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "expected_content"
      ],
      "properties": {
        "op": {
          "const": "delete_range"
        },
        "expected_content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insert_after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "anchor_text",
        "new_content"
      ],
      "properties": {
        "op": {
          "const": "insert_after"
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "new_content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insert_at_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "new_content"
      ],
      "properties": {
        "op": {
          "const": "insert_at_end"
        },
        "new_content": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
