{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/response-anthropic.schema.json",
  "title": "Forge Anthropic Agent Tool Responses",
  "description": "Anthropic tool definitions for Agent to Node responses. Pass each entry in tools[].",
  "provider": "anthropic",
  "tools": [
    {
      "name": "code_needed",
      "description": "Gọi khi cần xem nội dung file hiện có để tiếp tục code — chưa đủ thông tin để viết code ngay.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan",
          "files_requested",
          "reason"
        ],
        "properties": {
          "plan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/plan_item"
            }
          },
          "files_requested": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "$defs": {
          "plan_item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "NEW",
                  "MODIFY",
                  "READ_ONLY"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "name": "read_transcript_blocks",
      "description": "Read approved transcript rounds and approved project files through Forge services.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://forge.local/schemas/agent/tools/read-transcript-blocks.schema.json",
        "title": "Forge read transcript blocks tool input",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_ids",
          "rounds",
          "file_paths",
          "include",
          "max_chars"
        ],
        "properties": {
          "block_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rounds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "file_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "include": {
            "type": "string",
            "enum": [
              "request",
              "response",
              "both"
            ]
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 50000
          }
        }
      }
    },
    {
      "name": "planning",
      "description": "Return the implementation plan after reviewing the provided repository context.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan"
        ],
        "properties": {
          "plan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/plan_item"
            }
          }
        },
        "$defs": {
          "plan_item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "NEW",
                  "MODIFY",
                  "READ_ONLY"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "name": "submit_code_response",
      "description": "Trả code đã hoàn thành theo task được giao. Mỗi file phải đúng required_output_format đã được Node chỉ định.",
      "input_schema": {
        "type": "object",
        "required": [
          "explanation",
          "files"
        ],
        "properties": {
          "explanation": {
            "type": "string",
            "description": "Tóm tắt ngắn gọn đã làm gì và vì sao.",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/existing_file"
                },
                {
                  "$ref": "#/$defs/new_file"
                }
              ]
            },
            "minItems": 1
          }
        },
        "$defs": {
          "structured_patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operations"
            ],
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/replace_range"
                    },
                    {
                      "$ref": "#/$defs/delete_range"
                    },
                    {
                      "$ref": "#/$defs/insert_after"
                    },
                    {
                      "$ref": "#/$defs/insert_at_end"
                    }
                  ]
                }
              }
            }
          },
          "replace_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "expected_content",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "replace_range"
              },
              "expected_content": {
                "type": "string",
                "minLength": 1
              },
              "new_content": {
                "type": "string"
              }
            }
          },
          "delete_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "expected_content"
            ],
            "properties": {
              "op": {
                "const": "delete_range"
              },
              "expected_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "insert_after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "anchor_text",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "insert_after"
              },
              "anchor_text": {
                "type": "string",
                "minLength": 1
              },
              "new_content": {
                "type": "string"
              }
            }
          },
          "insert_at_end": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "insert_at_end"
              },
              "new_content": {
                "type": "string"
              }
            }
          },
          "existing_file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "content",
              "exists",
              "before_checksum"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "structured_patch"
              },
              "content": {
                "$ref": "#/$defs/structured_patch"
              },
              "exists": {
                "const": true
              },
              "before_checksum": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "new_file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "content",
              "exists",
              "before_checksum"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "full_content"
              },
              "content": {
                "type": "string"
              },
              "exists": {
                "const": false
              },
              "before_checksum": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "name": "usage_needed",
      "description": "Gọi khi cần xem file khác (thường là component cha) để biết cách đấu nối/sử dụng code vừa tạo vào hệ thống.",
      "input_schema": {
        "type": "object",
        "required": [
          "files_requested",
          "reason"
        ],
        "properties": {
          "files_requested": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "no_wiring_needed",
      "description": "Gọi khi xác nhận code vừa tạo KHÔNG cần đấu nối thêm ở bước này (nằm ngoài phạm vi ticket hiện tại).",
      "input_schema": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "completed",
      "description": "Gọi khi đã đối chiếu acceptance_criteria thuộc phạm vi của mình và xác nhận đã đáp ứng đủ.",
      "input_schema": {
        "type": "object",
        "required": [
          "status",
          "report"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "report": {
            "type": "object",
            "required": [
              "summary",
              "files_changed",
              "criteria_check"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "files_changed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "action"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "created",
                        "patched"
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "criteria_check": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "criteria",
                    "met"
                  ],
                  "properties": {
                    "criteria": {
                      "type": "string"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "known_limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "continue",
      "description": "Gọi khi vẫn còn việc cần làm thêm để đáp ứng đủ acceptance_criteria thuộc phạm vi của mình.",
      "input_schema": {
        "type": "object",
        "required": [
          "status",
          "next_task"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "continue"
            ]
          },
          "next_task": {
            "type": "object",
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
