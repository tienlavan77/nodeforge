{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/tools/write-diff.schema.json",
  "title": "Forge write diff tool input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "content",
    "before_checksum"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "content": {
      "type": "string"
    },
    "before_checksum": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    }
  }
}
