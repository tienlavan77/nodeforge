{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/tools/search-code.schema.json",
  "title": "Forge search code tool input",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "kind", "limit", "allowed_prefixes"],
  "properties": {
    "query": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": { "type": "string", "enum": ["file", "symbol", "content"] },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
    "allowed_prefixes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "projection": { "type": "string", "enum": ["minimal", "summary", "graph"], "default": "minimal" }
  }
}
