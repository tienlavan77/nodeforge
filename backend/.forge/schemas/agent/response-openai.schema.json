{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/response-openai.schema.json",
  "title": "Forge OpenAI Responses API Agent Tools",
  "description": "OpenAI Responses API function tools for Agent to Node responses. Each entry is passed as a tool.",
  "provider": "openai",
  "tools": [
    {
      "type": "function",
      "name": "code_needed",
      "description": "Gọi khi cần xem nội dung file hiện có để tiếp tục code — chưa đủ thông tin để viết code ngay. files_requested phải là đường dẫn file cụ thể, không bao giờ là thư mục.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files_requested",
          "reason"
        ],
        "properties": {
          "files_requested": {
            "type": "array",
            "uniqueItems": true,
            "description": "Individual file paths only — never directories.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "function",
      "name": "read_transcript_blocks",
      "description": "Read approved transcript rounds and approved project files through Forge services.",
      "strict": true,
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://forge.local/schemas/agent/tools/read-transcript-blocks.schema.json",
        "title": "Forge read transcript blocks tool input",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_ids",
          "rounds",
          "file_paths",
          "include",
          "max_chars"
        ],
        "properties": {
          "block_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rounds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "file_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "include": {
            "type": "string",
            "enum": [
              "request",
              "response",
              "both"
            ]
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 50000
          }
        }
      }
    },
    {
      "type": "function",
      "name": "planning",
      "description": "Return the implementation plan after reviewing the provided repository context.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan"
        ],
        "properties": {
          "plan": {
            "description": "Return exactly one entry per concrete filesystem path. Never repeat a path. For an ambiguous classification, use precedence NEW, then MODIFY, then READ_ONLY.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/plan_item"
            }
          }
        },
        "$defs": {
          "plan_item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 3,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:(?:[^/]+/)*[^/]+\\.[^/]+)$",
                "description": "Concrete relative filesystem file path, including extension."
              },
              "action": {
                "type": "string",
                "enum": [
                  "NEW",
                  "MODIFY",
                  "READ_ONLY"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "name": "patch_repair_response",
      "description": "Return only repaired patches, preserving each patch_id and the requested format.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repair_id",
          "repaired_patches"
        ],
        "properties": {
          "repair_id": {
            "type": "string",
            "minLength": 1
          },
          "repaired_patches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/full_content_patch"
                },
                {
                  "$ref": "#/$defs/structured_patch_repair"
                },
                {
                  "$ref": "#/$defs/apply_patch_repair"
                },
                {
                  "$ref": "#/$defs/unified_diff_repair"
                }
              ]
            }
          }
        },
        "$defs": {
          "structured_patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operations"
            ],
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/replace_range"
                    },
                    {
                      "$ref": "#/$defs/delete_range"
                    },
                    {
                      "$ref": "#/$defs/insert_after"
                    },
                    {
                      "$ref": "#/$defs/insert_at_end"
                    }
                  ]
                }
              }
            }
          },
          "replace_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "expected_content",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "replace_range"
              },
              "expected_content": {
                "type": "string",
                "minLength": 1
              },
              "new_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "delete_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "expected_content"
            ],
            "properties": {
              "op": {
                "const": "delete_range"
              },
              "expected_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "insert_after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "anchor_text",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "insert_after"
              },
              "anchor_text": {
                "type": "string",
                "minLength": 1
              },
              "new_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "insert_at_end": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "insert_at_end"
              },
              "new_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "full_content_patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "exists",
              "before_checksum",
              "content"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "full_content"
              },
              "exists": {
                "const": false
              },
              "before_checksum": {
                "type": "null"
              },
              "content": {
                "type": "string"
              }
            }
          },
          "structured_patch_repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "exists",
              "before_checksum",
              "content"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "structured_patch"
              },
              "exists": {
                "const": true
              },
              "before_checksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "content": {
                "$ref": "#/$defs/structured_patch"
              }
            }
          },
          "apply_patch_repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "exists",
              "before_checksum",
              "content"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "apply_patch"
              },
              "exists": {
                "const": true
              },
              "before_checksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "unified_diff_repair": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch_id",
              "path",
              "format",
              "exists",
              "before_checksum",
              "content"
            ],
            "properties": {
              "patch_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "unified_diff"
              },
              "exists": {
                "const": true
              },
              "before_checksum": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "name": "submit_code_response",
      "description": "Return code for EVERY NEW and MODIFY file in the approved execution plan. Every MODIFY file MUST include a structured_patch operation; never return only NEW-file content when MODIFY files exist.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "explanation",
          "files"
        ],
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "description": "Phải chứa mọi path có action NEW hoặc MODIFY trong execution plan; READ_ONLY không được gửi.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/existing_file"
                },
                {
                  "$ref": "#/$defs/new_file"
                }
              ]
            },
            "minItems": 1
          }
        },
        "$defs": {
          "structured_patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operations"
            ],
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/replace_range"
                    },
                    {
                      "$ref": "#/$defs/delete_range"
                    },
                    {
                      "$ref": "#/$defs/insert_after"
                    },
                    {
                      "$ref": "#/$defs/insert_at_end"
                    }
                  ]
                }
              }
            }
          },
          "replace_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "expected_content",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "replace_range"
              },
              "expected_content": {
                "type": "string",
                "minLength": 1
              },
              "new_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "delete_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "expected_content"
            ],
            "properties": {
              "op": {
                "const": "delete_range"
              },
              "expected_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "insert_after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "anchor_text",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "insert_after"
              },
              "anchor_text": {
                "type": "string",
                "minLength": 1
              },
              "new_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "insert_at_end": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "new_content"
            ],
            "properties": {
              "op": {
                "const": "insert_at_end"
              },
              "new_content": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "existing_file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "content",
              "exists",
              "before_checksum"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "structured_patch"
              },
              "content": {
                "$ref": "#/$defs/structured_patch"
              },
              "exists": {
                "const": true
              },
              "before_checksum": {
                "type": "string",
                "minLength": 1,
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "new_file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "content",
              "exists",
              "before_checksum"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "full_content"
              },
              "content": {
                "type": "string"
              },
              "exists": {
                "const": false
              },
              "before_checksum": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "name": "usage_needed",
      "description": "Gọi khi cần xem file khác (thường là component cha) để biết cách đấu nối/sử dụng code vừa tạo vào hệ thống.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files_requested",
          "reason"
        ],
        "properties": {
          "files_requested": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "function",
      "name": "no_wiring_needed",
      "description": "Gọi khi xác nhận code vừa tạo KHÔNG cần đấu nối thêm ở bước này (nằm ngoài phạm vi ticket hiện tại).",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "function",
      "name": "completed",
      "description": "Gọi khi đã đối chiếu acceptance_criteria thuộc phạm vi của mình và xác nhận đã đáp ứng đủ.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "report"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "report": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "files_changed",
              "criteria_check",
              "known_limitations"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "files_changed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "action",
                    "description"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "created",
                        "patched"
                      ]
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "criteria_check": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criteria",
                    "met",
                    "note"
                  ],
                  "properties": {
                    "criteria": {
                      "type": "string"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "known_limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "name": "continue",
      "description": "Gọi khi vẫn còn việc cần làm thêm để đáp ứng đủ acceptance_criteria thuộc phạm vi của mình.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "next_task"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "continue"
            ]
          },
          "next_task": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "reason"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
