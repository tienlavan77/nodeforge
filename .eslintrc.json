{
  "env": {
    "es2023": true,
    "node": true,
    "browser": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/",
    ".forge/"
  ],
  "rules": {
    "no-console": "off"
  }
}
