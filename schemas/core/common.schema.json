{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/core/common.schema.json",
  "title": "Forge Common Types",
  "type": "object",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "error",
        "critical"
      ]
    },
    "capability_scope": {
      "type": "object",
      "minProperties": 1,
      "description": "Generic, extensible capability declaration shared by system and AI agents. Each free-form capability group (for example 'filesystem', 'shell' or 'context') maps to one or more grants. A grant declares only a resource and permitted actions; path- and ACL-level authorization belongs exclusively to project/permission.schema.json.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resource",
            "actions"
          ],
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "hunks"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "old_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "change_type": {
                "type": "string",
                "enum": [
                  "add",
                  "modify",
                  "delete",
                  "rename"
                ]
              },
              "hunks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "old_start",
                    "old_lines",
                    "new_start",
                    "new_lines",
                    "lines"
                  ],
                  "properties": {
                    "old_start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "old_lines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "new_start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "new_lines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Unified-diff style lines, each prefixed with '+', '-' or ' '."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
