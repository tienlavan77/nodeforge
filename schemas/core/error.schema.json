{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/core/error.schema.json",
  "title": "Forge Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "severity"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_:-]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
