    "event_type": {
      "type": "string",
      "enum": [
        "node.status_change",
        "node.execution_step",
        "node.command",
        "node.command_result",
        "agent.text_stream",
        "execution.step",
        "execution.dispatch_result",
        "verification.command",
        "verification.command_result",
        "git.status",
        "git.add",
        "git.commit",
        "index.started",
        "index.completed",
        "index.skipped",
        "index.failed"
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
