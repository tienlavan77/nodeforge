          ],
          "properties": {
            "explanation": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "language",
                  "format",
                  "content",
                  "exists"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "full",
                      "unified_diff",
                      "patch"
                    ]
                  },
                  "content": {
                    "type": "string",
                    "description": "Với format 'patch', encode object operations thành chuỗi JSON (JSON.stringify) — OpenAI Structured Outputs strict mode không hỗ trợ union type cho 1 field."
                  },
                  "exists": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "usage_needed": {
      "type": "function",
      "function": {
        "name": "usage_needed",
        "description": "Gọi khi cần xem file khác (thường là component cha) để biết cách đấu nối/sử dụng code vừa tạo vào hệ thống.",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files_requested",
            "reason"
          ],
          "properties": {
            "files_requested": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "no_wiring_needed": {
      "type": "function",
      "function": {
        "name": "no_wiring_needed",
        "description": "Gọi khi xác nhận code vừa tạo KHÔNG cần đấu nối thêm ở bước này (nằm ngoài phạm vi ticket hiện tại).",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "completed": {
      "type": "function",
      "function": {
        "name": "completed",
        "description": "Gọi khi đã đối chiếu acceptance_criteria thuộc phạm vi của mình và xác nhận đã đáp ứng đủ.",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "report"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "completed"
              ]
            },
            "report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "files_changed",
                "criteria_check",
                "known_limitations"
              ],
              "properties": {
                "summary": {
                  "type": "string"
                },
                "files_changed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "action",
                      "description"
                    ],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "created",
                          "patched"
                        ]
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                },
                "criteria_check": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criteria",
                      "met",
                      "note"
                    ],
                    "properties": {
                      "criteria": {
                        "type": "string"
                      },
                      "met": {
                        "type": "boolean"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                },
                "known_limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "continue": {
      "type": "function",
      "function": {
        "name": "continue",
        "description": "Gọi khi vẫn còn việc cần làm thêm để đáp ứng đủ acceptance_criteria thuộc phạm vi của mình.",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
