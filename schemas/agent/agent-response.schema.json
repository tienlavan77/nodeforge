{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/agent-response.schema.json",
  "title": "Forge Agent Response v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "step_id", "status", "usage", "changes", "explanation", "confidence"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.3" },
    "task_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["success", "failed", "partial"] },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_creation_input_tokens", "cache_read_input_tokens", "input_tokens", "output_tokens"],
      "properties": {
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": { "type": "array" },
    "explanation": { "type": "string" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
  }
}
