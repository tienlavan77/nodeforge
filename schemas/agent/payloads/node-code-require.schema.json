{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/node-code-require.schema.json",
  "title": "Forge Node Code Require Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "step_id",
    "plan",
    "task_context"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "integer",
      "minimum": 1
    },
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction_blocks"
      ],
      "properties": {
        "instruction_blocks": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": [
              "block_id"
            ],
            "properties": {
              "block_id": {
                "const": "code_require"
              }
            },
            "additionalProperties": true
          }
        },
        "user_blocks": {
          "type": "array"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry_of_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "previous_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      }
    },
    "cache_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_cache_key",
        "mode",
        "ttl"
      ],
      "properties": {
        "prompt_cache_key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "automatic"
          ]
        },
        "ttl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "transport"
      ],
      "properties": {
        "type": {
          "const": "submit_code_response"
        },
        "transport": {
          "const": "function_tool"
        }
      }
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/new_plan_item"
          },
          {
            "$ref": "#/$defs/modify_plan_item"
          },
          {
            "$ref": "#/$defs/read_only_plan_item"
          }
        ]
      }
    }
  },
  "$defs": {
    "new_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action",
        "representation",
        "before_checksum",
        "reason",
        "current_content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "NEW"
        },
        "representation": {
          "const": "full_content"
        },
        "before_checksum": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "current_content": {
          "type": "null"
        }
      }
    },
    "modify_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action",
        "representation",
        "before_checksum",
        "reason",
        "current_content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "MODIFY"
        },
        "representation": {
          "const": "structured_patch"
        },
        "before_checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "current_content": {
          "type": "string"
        }
      }
    },
    "read_only_plan_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "action",
        "representation",
        "before_checksum",
        "reason",
        "current_content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "READ_ONLY"
        },
        "representation": {
          "const": "none"
        },
        "before_checksum": {
          "type": "null"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "current_content": {
          "type": "string"
        }
      }
    }
  }
}
