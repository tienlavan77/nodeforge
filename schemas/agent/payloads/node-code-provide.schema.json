{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/node-code-provide.schema.json",
  "title": "Forge Node Code Provide Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "step_id",
    "files"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "integer",
      "minimum": 1
    },
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_blocks": {
          "type": "array"
        },
        "instruction_blocks": {
          "type": "array"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "exists",
          "content",
          "before_checksum",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "exists": {
            "type": "boolean"
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "before_checksum": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "language": {
            "type": "string"
          },
          "index": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "expected_submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "representation": {
          "type": "string",
          "enum": [
            "full_content",
            "unified_diff",
            "apply_patch",
            "structured_patch",
            "per_file"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "function_tool",
            "json_schema"
          ]
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry_of_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "previous_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      }
    },
    "cache_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_cache_key",
        "mode",
        "ttl"
      ],
      "properties": {
        "prompt_cache_key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "automatic"
          ]
        },
        "ttl": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
