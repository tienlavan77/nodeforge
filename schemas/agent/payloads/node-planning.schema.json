{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/node-planning.schema.json",
  "title": "NodeForge Planning Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "step_id",
    "files",
    "expected_output"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "integer",
      "minimum": 1
    },
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_blocks": {
          "type": "array"
        },
        "instruction_blocks": {
          "type": "array"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "exists",
          "content",
          "before_checksum",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "exists": {
            "type": "boolean"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "before_checksum": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "language": {
            "type": "string"
          },
          "index": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry_of_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "previous_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      }
    },
    "cache_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_cache_key",
        "mode",
        "ttl"
      ],
      "properties": {
        "prompt_cache_key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "automatic"
          ]
        },
        "ttl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "representation",
        "transport"
      ],
      "properties": {
        "type": {
          "const": "planning"
        },
        "representation": {
          "const": "json"
        },
        "transport": {
          "const": "function_tool"
        }
      }
    }
  }
}
