{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/agent-code-needed.schema.json",
  "title": "NodeForge Code Needed Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files_requested",
    "reason"
  ],
  "properties": {
    "files_requested": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
