{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/agent-code-response.schema.json",
  "title": "Agent Submit Code Response Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "explanation",
    "files"
  ],
  "properties": {
    "explanation": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/existing_file"
          },
          {
            "$ref": "#/$defs/new_file"
          }
        ]
      }
    }
  },
  "$defs": {
    "structured_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/replace_range"
              },
              {
                "$ref": "#/$defs/delete_range"
              },
              {
                "$ref": "#/$defs/insert_after"
              },
              {
                "$ref": "#/$defs/insert_at_end"
              }
            ]
          }
        }
      }
    },
    "replace_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "expected_content",
        "new_content"
      ],
      "properties": {
        "op": {
          "const": "replace_range"
        },
        "expected_content": {
          "type": "string",
          "minLength": 1
        },
        "new_content": {
          "type": "string"
        }
      }
    },
    "delete_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "expected_content"
      ],
      "properties": {
        "op": {
          "const": "delete_range"
        },
        "expected_content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insert_after": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "anchor_text",
        "new_content"
      ],
      "properties": {
        "op": {
          "const": "insert_after"
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "new_content": {
          "type": "string"
        }
      }
    },
    "insert_at_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "new_content"
      ],
      "properties": {
        "op": {
          "const": "insert_at_end"
        },
        "new_content": {
          "type": "string"
        }
      }
    },
    "existing_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "language",
        "format",
        "content",
        "exists",
        "before_checksum"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "structured_patch"
        },
        "content": {
          "$ref": "#/$defs/structured_patch"
        },
        "exists": {
          "const": true
        },
        "before_checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "new_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "language",
        "format",
        "content",
        "exists",
        "before_checksum",
        "summary"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "full_content"
        },
        "content": {
          "type": "string"
        },
        "exists": {
          "const": false
        },
        "before_checksum": {
          "type": "null"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    }
  }
}
