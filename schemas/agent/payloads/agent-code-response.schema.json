{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/agent-code-response.schema.json",
  "title": "Agent Submit Code Response Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["explanation", "files"],
  "properties": {
    "explanation": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language", "format", "content", "exists", "before_checksum"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["full_content", "unified_diff", "patch"] },
          "content": { "type": "string" },
          "exists": { "type": "boolean" },
            "before_checksum": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
            "summary": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n]+$" }
          },
          "allOf": [{ "if": { "properties": { "exists": { "const": false } }, "required": ["exists"] }, "then": { "required": ["summary"] } }]
        }
      }
    }
  }
