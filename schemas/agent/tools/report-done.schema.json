{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/tools/report-done.schema.json",
  "title": "Forge report done tool input",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "status": { "type": "string", "enum": ["completed", "blocked", "needs_context"] },
    "blocker": {
      "type": "object", "additionalProperties": false,
      "required": ["reason_code"],
      "anyOf": [{ "required": ["consultation"], "properties": { "consultation": {} } }, { "required": ["owner_action"], "properties": { "owner_action": {} } }],
      "properties": {
        "reason_code": { "type": "string", "enum": ["SCOPE_CONFLICT", "CONTRACT_DECISION_REQUIRED", "ACCESS_REQUIRED", "SECURITY_RISK", "ACCEPTANCE_AMBIGUOUS"] },
        "owner_action": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "Legacy requested decision; Node routes it to SL, not directly to Owner." },
        "consultation": {
          "type": "object", "additionalProperties": false,
          "required": ["question", "decision_needed", "known_decision_refs", "impact"],
          "properties": {
            "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "decision_needed": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "known_decision_refs": { "type": "array", "maxItems": 100, "items": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "object" }] } },
            "impact": { "type": "string", "minLength": 1, "maxLength": 4000 }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "acceptance_criteria": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
    "acceptance_coverage": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": [], "properties": { "criterion": { "type": "string", "minLength": 1 }, "criterion_id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }, "criterion_index": { "type": "integer", "minimum": 0, "maximum": 49 }, "status": { "type": "string", "enum": ["verified", "evidence_pending", "not_applicable"] }, "command_kind": { "type": "string", "enum": ["test", "backend_tests", "build", "lint", "typecheck", "schema_validation", "browser"] }, "test_path": { "type": ["string", "null"] } } } },
    "implementation_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["changed_files", "not_changed_files", "scope_rationale"],
      "properties": {
        "changed_files": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
        "not_changed_files": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
        "scope_rationale": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "evidence": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["type", "reference", "result"], "properties": { "type": { "type": "string", "minLength": 1 }, "reference": { "type": "string", "minLength": 1 }, "result": { "type": "string", "minLength": 1 } } } },
    "reviewer_notes": { "type": "array", "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["topic", "position", "rationale", "evidence_refs"], "properties": { "topic": { "type": "string", "minLength": 1 }, "position": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } } } } }
  },
  "allOf": [{ "if": { "required": ["status"], "properties": { "status": { "const": "blocked" } } }, "then": { "required": ["summary", "blocker", "evidence"], "properties": { "summary": {}, "blocker": {}, "evidence": { "type": "array", "minItems": 1 } } }, "else": { "not": { "properties": { "blocker": {} }, "required": ["blocker"] } } }]
}
