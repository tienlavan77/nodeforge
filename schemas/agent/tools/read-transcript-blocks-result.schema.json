{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/tools/read-transcript-blocks-result.schema.json",
  "title": "Forge read transcript blocks tool result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "blocks",
    "files"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
