{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/agent-code-response.schema.json",
  "title": "Agent Submit Code Response Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["explanation", "files"],
  "properties": {
    "explanation": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language", "format", "content", "exists"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["full", "unified_diff", "patch"] },
          "content": { "type": "string" },
          "exists": { "type": "boolean" }
        }
      }
    }
  }
}
