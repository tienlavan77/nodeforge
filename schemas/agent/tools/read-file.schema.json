{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/agent/tools/read-file.schema.json",
  "title": "Forge read file tool input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "symbol": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Current symbol name to read (exclusive with offset and limit)"
    },
    "offset": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "1-based start line, inclusive"
    },
    "limit": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 250,
      "description": "max lines to return: 250 for Markdown, 80 for source files"
    }
  }
}
