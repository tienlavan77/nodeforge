{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/project/project.schema.json",
  "title": "Forge Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "root",
    "schema_version"
  ],
  "properties": {
    "project_id": {
      "allOf": [
        {
          "$ref": "../core/common.schema.json#/$defs/id"
        },
        {
          "type": "string",
          "pattern": "^(?:PROJECT-[A-Za-z0-9_-]+|[a-z0-9]+(?:-[a-z0-9]+)*)$"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "root": {
      "$ref": "../core/common.schema.json#/$defs/path"
    },
    "git_url": {
      "type": "string"
    },
    "forge_dir": {
      "type": "string",
      "default": ".forge"
    },
    "schema_version": {
      "$ref": "../core/common.schema.json#/$defs/version"
    },
    "default_branch": {
      "type": "string"
    },
    "default_workflow_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "workflow.schema.json id used for new tasks unless a task specifies its own workflow_id."
    },
    "created_at": {
      "$ref": "../core/common.schema.json#/$defs/timestamp"
    },
    "language": {
      "type": "string"
    },
    "package_manager": {
      "type": "string"
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "dev": {
          "type": "string"
        }
      }
    },
    "comment_language": {
      "type": "string",
      "default": "en"
    },
    "default_agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture_manager": {
          "type": "string"
        },
        "sprint_leader": {
          "type": "string"
        },
        "coder": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "homepage_url": {
      "type": "string"
    },
    "docs_url": {
      "type": "string"
    },
    "metadata": {
      "$ref": "../core/common.schema.json#/$defs/metadata"
    }
  }
}
