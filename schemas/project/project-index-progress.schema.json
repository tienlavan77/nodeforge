{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed project index progress",
  "description": "Attempt progress separates committed outcomes, parser-specific function inventory, readiness and embedding work at an explicit index version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt","revision","stage","status","stages","progress","counters","failures","checkpoint","embedding","function_kinds"],
  "properties": {
    "attempt": {"type":"integer","minimum":1},
    "revision": {"type":"integer","minimum":0},
    "stage": {"enum":["preflight","identity","membership","comment_normalization","scan/index","resolve","embedding","startup/readiness"]},
    "status": {"enum":["running","succeeded","failed"]},
    "stages": {"type":"object","additionalProperties":false,"required":["preflight","identity","membership","comment_normalization","scan/index","resolve","embedding","startup/readiness"],"properties":{"preflight":{"enum":["pending","running","completed","failed"]},"identity":{"enum":["pending","running","completed","failed"]},"membership":{"enum":["pending","running","completed","failed"]},"comment_normalization":{"enum":["pending","running","completed","failed"]},"scan/index":{"enum":["pending","running","completed","failed"]},"resolve":{"enum":["pending","running","completed","failed"]},"embedding":{"enum":["pending","running","completed","failed"]},"startup/readiness":{"enum":["pending","running","completed","failed"]}}},
    "progress": {"type":"object","additionalProperties":false,"required":["mode","total","percent","eta"],"properties":{"mode":{"const":"indeterminate"},"total":{"type":"null"},"percent":{"type":"null"},"eta":{"type":"null"}}},
    "counters": {"type":"object","additionalProperties":false,"required":["discovered","eligible","indexed","unchanged","unsupported","ignored","failed","deleted"],"properties":{"discovered":{"type":"integer","minimum":0},"eligible":{"type":"integer","minimum":0},"indexed":{"type":"integer","minimum":0},"unchanged":{"type":"integer","minimum":0},"unsupported":{"type":"integer","minimum":0},"ignored":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0},"deleted":{"type":"integer","minimum":0}}},
    "failures": {"type":"array","items":{"type":"object","required":["path","marker","message"],"properties":{"path":{"type":"string"},"marker":{"type":"string"},"message":{"type":"string"},"resolved":{"type":"boolean"}}}},
    "checkpoint": {"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["version","files","functions"],"properties":{"version":{"type":"integer","minimum":0},"files":{"type":"integer","minimum":0},"functions":{"type":"integer","minimum":0}}}]},
    "embedding": {"type":"object","additionalProperties":false,"required":["status","pending","processing","succeeded","failed"],"properties":{"status":{"enum":["pending","running","succeeded","failed"]},"error":{"type":"string"},"pending":{"type":"integer","minimum":0},"processing":{"type":"integer","minimum":0},"succeeded":{"type":"integer","minimum":0},"failed":{"type":"integer","minimum":0}}},
    "function_kinds": {"const":{"javascript":["function","method","hook","component"],"typescript":["function","method","hook","component"],"php":["function","method"],"css":[]}}
  },
  "$id": "https://forge.local/schemas/project/project-index-progress.schema.json"
}
