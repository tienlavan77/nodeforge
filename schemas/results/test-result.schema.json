{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/results/test-result.schema.json",
  "title": "Forge Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "status",
    "exit_code",
    "started_at",
    "duration_ms"
  ],
  "properties": {
    "id": {
      "$ref": "../core/common.schema.json#/$defs/id"
    },
    "project_id": {
      "$ref": "../core/common.schema.json#/$defs/id"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "cancelled",
        "timeout",
        "skipped"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "command": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "targeted",
        "integration",
        "full",
        "custom"
      ]
    },
    "started_at": {
      "$ref": "../core/common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          }
        }
      }
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "metadata": {
      "$ref": "../core/common.schema.json#/$defs/metadata"
    }
  }
}
