{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/results/check-result.schema.json",
  "title": "Forge Check Result",
  "description": "Result of a build, lint, or typecheck run — the three verification kinds that share one shape (pass/fail + a list of diagnostics), as opposed to Test Result which needs its own richer structure (pass/fail counts, per-test failures). Use `kind` to distinguish which check produced this result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "kind",
    "status",
    "started_at",
    "duration_ms"
  ],
  "properties": {
    "id": {
      "$ref": "../core/common.schema.json#/$defs/id"
    },
    "project_id": {
      "$ref": "../core/common.schema.json#/$defs/id"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "build",
        "lint",
        "typecheck"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "cancelled",
        "timeout",
        "skipped"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "command": {
      "type": "string"
    },
    "started_at": {
      "$ref": "../core/common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "description": "Individual errors/warnings, e.g. one per lint violation or typecheck error.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "message"
        ],
        "properties": {
          "severity": {
            "$ref": "../core/common.schema.json#/$defs/severity"
          },
          "message": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "rule_id": {
            "type": "string",
            "description": "e.g. the ESLint rule name or TS error code."
          }
        }
      }
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "metadata": {
      "$ref": "../core/common.schema.json#/$defs/metadata"
    }
  }
}
