{
  "$comment": "Describes existing recovery authority and candidate metadata inside the shared transport; owning services still validate approval, hashes and live execution binding.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/governance/agent-exchange-decision.schema.json",
  "type": "object", "additionalProperties": false, "required": ["action", "summary"],
  "properties": {
    "action": { "enum": ["resolved", "sprint_required", "architecture_required", "reconciliation_required", "coder_requested", "dependency_requested", "owner_required", "governance_required"] },
    "summary": { "$ref": "#/$defs/text" }, "guidance": { "$ref": "#/$defs/text" },
    "authority_scope": { "enum": ["sprint", "architecture"] },
    "authority_quote": { "$ref": "#/$defs/text" },
    "authority_reference": { "$ref": "#/$defs/authority" },
    "architecture_basis": {
      "type": "object", "required": ["plan_id", "revision", "sha256"], "additionalProperties": false,
      "properties": { "plan_id": { "$ref": "#/$defs/text" }, "revision": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "boundary_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["rationale", "changes_structure", "changes_owner_scope", "changes_security_policy", "changes_data_semantics", "overrides_guardrails", "changes_ticket_contract"],
      "properties": {
        "rationale": { "$ref": "#/$defs/text" }, "changes_structure": { "type": "boolean" },
        "changes_owner_scope": { "type": "boolean" }, "changes_security_policy": { "type": "boolean" },
        "changes_data_semantics": { "type": "boolean" }, "overrides_guardrails": { "type": "boolean" }, "changes_ticket_contract": { "type": "boolean" }
      }
    },
    "evidence": { "$ref": "#/$defs/source_evidence" },
    "technical_result": {
      "type": "object", "additionalProperties": false, "required": ["findings", "implementation_steps", "verification_steps", "admission"],
      "properties": {
        "findings": { "$ref": "#/$defs/texts" }, "implementation_steps": { "$ref": "#/$defs/texts" }, "verification_steps": { "$ref": "#/$defs/texts" },
        "admission": { "type": "object", "additionalProperties": false, "required": ["status", "rationale"],
          "properties": { "status": { "enum": ["within_existing_permissions", "denied", "unresolved"] }, "rationale": { "$ref": "#/$defs/text" } } }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false, "required": ["kind", "prerequisite", "completed_checks", "next_check"],
      "properties": {
        "kind": { "enum": ["technical_design", "source_revision", "execution_admission", "dependency", "file_claim", "tooling"] },
        "prerequisite": { "$ref": "#/$defs/text" }, "completed_checks": { "$ref": "#/$defs/texts" }, "next_check": { "$ref": "#/$defs/text" },
        "owner_request": {
          "$comment": "Requests a direct human answer for technical recovery; it neither escalates AM policy authority nor grants execution permission.",
          "type": "object", "additionalProperties": false, "required": ["kind", "question", "context"],
          "properties": { "kind": { "enum": ["information", "tool_authorization"] },
            "question": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
            "context": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" } }
        },
        "waiting_for": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/text" }, {
          "type": "object", "additionalProperties": false, "required": ["owner", "operation", "question"],
          "properties": { "owner": { "enum": ["coder", "architecture_manager", "reviewer", "external"] }, "operation": { "enum": ["inspect", "execute"] }, "question": { "$ref": "#/$defs/text" }, "subject": { "$ref": "#/$defs/review_subject" } },
          "if": { "properties": { "owner": { "const": "reviewer" } } },
          "then": { "required": ["subject"], "properties": { "operation": { "const": "inspect" } } }
        }] } }
      }
    },
    "coder_request": {
      "type": "object", "additionalProperties": false, "required": ["questions", "constraints"],
      "properties": { "questions": { "$ref": "#/$defs/texts" }, "constraints": { "$ref": "#/$defs/texts" }, "criterion_ids": { "$ref": "#/$defs/texts" } }
    },
    "dependency_request": {
      "description": "SL requests execution of a repair in an approved upstream ticket of this Sprint. Node retains the waiting ticket checkpoint and runs the target's own Coder, verification and independent review.",
      "type": "object", "additionalProperties": false,
      "required": ["ticket_id", "reason", "instructions", "expected_results", "evidence_refs"],
      "properties": {
        "ticket_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 200 },
        "reason": { "$ref": "#/$defs/dependency_text" }, "instructions": { "$ref": "#/$defs/dependency_text" },
        "expected_results": { "$ref": "#/$defs/dependency_texts" }, "evidence_refs": { "$ref": "#/$defs/dependency_texts" }
      }
    },
    "candidate_review": { "type": "object", "additionalProperties": false, "required": ["candidate_sha256", "verdict", "comments"],
      "properties": { "candidate_sha256": { "$ref": "#/$defs/hash" }, "verdict": { "enum": ["approved", "changes_requested"] }, "comments": { "$ref": "#/$defs/texts" } } },
    "criterion_updates": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["criterion_id", "files", "remaining_work"],
      "properties": { "criterion_id": { "$ref": "#/$defs/text" }, "remaining_work": { "type": "string", "maxLength": 8000 },
        "files": { "$ref": "#/$defs/evidence" } }
    } },
    "escalation": {
      "type": "object", "required": ["boundary", "rationale"],
      "properties": { "boundary": { "enum": ["system_structure", "owner_scope", "security_policy", "data_semantics", "explicit_owner_guardrail"] },
        "rationale": { "$ref": "#/$defs/text" }, "authority_scope": { "enum": ["sprint", "architecture"] },
        "authority_reference": { "$ref": "#/$defs/authority" }, "authority_quote": { "$ref": "#/$defs/text" } }
    },
    "proposal": {
      "type": "object", "required": ["title", "options", "recommended_option_id"],
      "properties": { "title": { "$ref": "#/$defs/text" }, "recommended_option_id": { "$ref": "#/$defs/text" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "required": ["id", "description"], "properties": { "id": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" } } } } }
    },
    "contract_draft": { "type": "object", "additionalProperties": false, "required": ["title", "markdown", "evidence"],
      "properties": { "title": { "$ref": "#/$defs/text" }, "markdown": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/required_source_evidence" } } }
  },
  "allOf": [{
    "if": { "required": ["action"], "properties": { "action": { "enum": ["resolved", "sprint_required", "owner_required"] } } },
    "then": { "required": ["evidence"], "properties": { "evidence": { "$ref": "#/$defs/required_source_evidence" } } }
  }, {
    "if": { "required": ["dependency_request"] }, "then": { "properties": { "action": { "const": "dependency_requested" } } }
  }, {
    "if": { "required": ["action"], "properties": { "action": { "const": "dependency_requested" } } },
    "then": { "required": ["dependency_request", "guidance", "authority_scope", "authority_reference"], "properties": {
      "authority_scope": { "const": "sprint" }, "architecture_basis": false, "boundary_assessment": false, "escalation": false,
      "proposal": false, "contract_draft": false, "reconciliation": false, "technical_result": false, "coder_request": false, "candidate_review": false } }
  }],
  "$defs": {
    "dependency_text": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
    "dependency_texts": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/dependency_text" } },
    "review_subject": {
      "$comment": "Pins independent blocker evidence to a retained ticket commit and artifact without granting verification acceptance.",
      "type": "object", "additionalProperties": false, "required": ["commit_sha", "artifact_id"],
      "properties": { "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" },
        "artifact_id": { "type": "string", "pattern": "^ARTIFACT-[A-Za-z0-9-]+$" } }
    },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" }, "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "type": "object", "additionalProperties": false, "required": ["passage_id", "rationale"],
      "properties": { "passage_id": { "$ref": "#/$defs/text" }, "rationale": { "$ref": "#/$defs/text" } } },
    "source_evidence": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/evidence/items" },
      "description": "Inspected source paths and bare full-file SHA-256 values. May be omitted or empty for a consultation or missing-evidence request; never fabricate source evidence to ask another role a question." },
    "required_source_evidence": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/evidence/items" },
      "description": "A completed decision or Owner escalation requires 1-16 inspected source references; reads are evidence, never approval." },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/text" }, "sha256": { "$ref": "#/$defs/hash" } } } }
  }
}
