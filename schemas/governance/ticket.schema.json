{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/governance/ticket.schema.json",
  "title": "Forge Governance Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "roadmap_id", "sprint_id", "title", "objective", "acceptance_criteria", "provenance"],
  "$defs": {
    "candidateFile": { "type": "object", "additionalProperties": false, "required": ["path", "role"], "properties": {
      "path": { "type": "string", "minLength": 1 },
      "role": { "type": "string", "enum": ["PATCH", "REUSE", "REFERENCE", "IGNORE"] },
      "symbol": { "type": "string", "minLength": 1 },
      "reason": { "type": "string" }
    }, "allOf": [
      { "if": { "properties": { "role": { "const": "PATCH" } }, "required": ["role"] }, "then": { "properties": { "symbol": { "type": "string", "minLength": 1 } }, "required": ["symbol"] } },
      { "if": { "properties": { "role": { "const": "REUSE" } }, "required": ["role"] }, "then": { "properties": { "symbol": { "type": "string", "minLength": 1 } }, "required": ["symbol"] } }
    ] }
  },
  "properties": {
    "rollout_package": { "type": "string", "enum": ["A1", "A2", "A3", "A4", "A5", "A6"] },
    "execution_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "acceptance_criteria", "verification_plan", "owner", "supervisor", "coder", "reviewer", "human_authority", "dependencies", "gate", "ledger_revision", "idempotency_key"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "verification_plan": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "supervisor": { "type": "string", "minLength": 1 },
        "coder": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "human_authority": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "gate": { "const": "shadow" },
        "ledger_revision": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 }
      }
    },
    "id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "project_id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "roadmap_id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "sprint_id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "vocabulary_hints": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "candidate_files": { "type": "array", "items": { "$ref": "#/$defs/candidateFile" }, "minItems": 1 },
    "candidates_produced_by": { "type": "string" },
    "candidates_produced_at": { "$ref": "../core/common.schema.json#/$defs/timestamp" },
    "priority": { "type": "string", "enum": ["low", "medium", "normal", "high", "critical"] },
    "style": { "type": "array", "items": { "type": "string", "enum": ["frontend", "backend", "security", "infra", "docs"] }, "minItems": 1, "maxItems": 1, "uniqueItems": true },
    "implementation_type": { "type": "array", "items": { "type": "string", "enum": ["frontend", "backend", "security"] }, "minItems": 1, "maxItems": 1, "uniqueItems": true },
    "change_nature": { "type": "string", "enum": ["presentation-only"] },
    "file_budget": { "type": "integer", "minimum": 1, "maximum": 4 },
    "status": { "type": "string", "enum": ["planned", "pending", "running", "reviewing", "done", "failed", "needs_human_review"] },
    "last_error": { "type": "string" },
    "dependencies": { "type": "array", "items": { "$ref": "../core/common.schema.json#/$defs/id" }, "uniqueItems": true },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["source", "source_id", "created_at"], "properties": {
      "source": { "type": "string", "enum": ["sprint_plan", "architecture_decision", "project_owner"] },
      "source_id": { "$ref": "../core/common.schema.json#/$defs/id" },
      "created_at": { "$ref": "../core/common.schema.json#/$defs/timestamp" }
    } }
  },
  "allOf": [{
    "if": { "properties": { "rollout_package": { "const": "A5" } }, "required": ["rollout_package"] },
    "then": { "required": ["execution_contract"], "properties": { "execution_contract": {} } }
  }, {
    "if": { "properties": { "change_nature": { "const": "presentation-only" } }, "required": ["change_nature"] },
    "then": { "properties": { "implementation_type": { "const": ["frontend"] } }, "required": ["implementation_type"] }
  }],
  "oneOf": [
    { "properties": { "implementation_type": true }, "required": ["implementation_type"] },
    { "properties": { "style": true }, "required": ["style"] }
  ]
}
