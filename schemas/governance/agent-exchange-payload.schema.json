{
  "$comment": "Selects the typed request, response, work, review or correction payload for the shared agent exchange without inventing new business authority.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/governance/agent-exchange-payload.schema.json",
  "title": "Agent exchange payloads selected by kind",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "refs": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "object"}]}},
    "consultation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "decision_needed", "known_decision_refs", "impact"],
      "properties": {
        "question": {"$ref": "#/$defs/text"},
        "decision_needed": {"$ref": "#/$defs/text"},
        "known_decision_refs": {"$ref": "#/$defs/refs"},
        "impact": {"$ref": "#/$defs/text"},
        "structure_change_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure", "proposed_change", "rationale", "evidence_refs"],
          "properties": {"structure": {"$ref": "#/$defs/text"}, "proposed_change": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}
        },
        "owner_boundary_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boundary", "proposed_change", "rationale", "evidence_refs"],
          "properties": {"boundary": {"enum": ["approved_scope", "system_structure"]}, "proposed_change": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}
        }
      }
    },
    "consultation_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "answer", "rationale", "authority_refs", "next_steps"],
      "properties": {
        "outcome": {"enum": ["answered", "needs_evidence", "needs_higher_authority"]},
        "answer": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/text"},
        "authority_refs": {"$ref": "#/$defs/refs"},
        "next_steps": {"$ref": "#/$defs/texts"},
        "missing_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["needed", "needed_for"], "properties": {"needed": {"$ref": "#/$defs/text"}, "needed_for": {"$ref": "#/$defs/text"}, "source_ref": {"$ref": "#/$defs/text"}}}},
        "consultation": {"$ref": "#/$defs/consultation_request"},
        "decision": {"$ref": "agent-exchange-decision.schema.json"}
      },
      "allOf": [{"if": {"properties": {"outcome": {"const": "needs_evidence"}}}, "then": {"required": ["missing_evidence"]}}, {"if": {"properties": {"outcome": {"const": "needs_higher_authority"}}}, "then": {"required": ["consultation"]}}]
    },
    "work_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "criterion_ids", "decision_refs", "remaining_work", "expected_outputs"],
      "properties": {"objective": {"$ref": "#/$defs/text"}, "criterion_ids": {"$ref": "#/$defs/texts"}, "decision_refs": {"$ref": "#/$defs/refs"}, "remaining_work": {"$ref": "#/$defs/texts"}, "expected_outputs": {"$ref": "#/$defs/texts"}}
    },
    "work_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "summary", "change_refs", "verification_refs", "report_ref", "remaining_work"],
      "properties": {
        "outcome": {"enum": ["completed", "partial", "blocked"]},
        "summary": {"$ref": "#/$defs/text"},
        "change_refs": {"$ref": "#/$defs/refs"},
        "verification_refs": {"$ref": "#/$defs/refs"},
        "report_ref": {"type": ["string", "null"], "minLength": 1},
        "remaining_work": {"$ref": "#/$defs/texts"},
        "candidate": {"type": "object"},
        "consultation": {"$ref": "#/$defs/consultation_request"}
      }
    },
    "review_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "criterion_ids", "report_ref", "finding_refs"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/text"},
        "criterion_ids": {"$ref": "#/$defs/texts"},
        "report_ref": {"type": ["string", "null"], "minLength": 1},
        "finding_refs": {"$ref": "#/$defs/texts"},
        "purpose": {"const": "blocker_evidence"},
        "question": {"$ref": "#/$defs/text"},
        "subject": {"$ref": "agent-exchange-decision.schema.json#/$defs/review_subject"}
      },
      "if": {"required": ["purpose"]},
      "then": {"required": ["question", "subject"]}
    },
    "review_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings", "finding_updates"],
      "properties": {
        "verdict": {"enum": ["approved", "request_changes", "verification_required"]},
        "summary": {"$ref": "#/$defs/text"},
        "findings": {"type": "array", "items": {"oneOf": [{"type": "object"}, {"$ref": "#/$defs/text"}]}},
        "finding_updates": {"type": "array", "items": {"type": "object"}},
        "purpose": {"const": "blocker_evidence"},
        "subject": {"$ref": "agent-exchange-decision.schema.json#/$defs/review_subject"},
        "outcome": {"enum": ["completed", "inconclusive"]},
        "observations": {"$ref": "#/$defs/texts"},
        "missing_evidence": {"$ref": "#/$defs/texts"},
        "verification_requests": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/verification_request"}}
      },
      "if": {"required": ["purpose"]},
      "then": {"required": ["subject", "outcome", "observations", "missing_evidence"], "not": {"required": ["verdict"]}, "properties": {"findings": {"maxItems": 0}, "finding_updates": {"maxItems": 0}, "observations": {"minItems": 1, "maxItems": 16}}},
      "else": {"required": ["verdict"], "not": {"anyOf": [{"required": ["subject"]}, {"required": ["outcome"]}, {"required": ["observations"]}, {"required": ["missing_evidence"]}]}},
      "allOf": [
        {
          "if": {"required": ["verdict"], "properties": {"verdict": {"const": "verification_required"}}},
          "then": {"required": ["verification_requests"], "properties": {"findings": {"maxItems": 0}, "finding_updates": {"maxItems": 0}}},
          "else": {"not": {"required": ["verification_requests"]}}
        }
      ]
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "response_ref", "instruction"],
      "properties": {
        "errors": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "code", "message"], "properties": {"path": {"type": "string"}, "code": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"}}}},
        "response_ref": {"$ref": "#/$defs/text"},
        "instruction": {"$ref": "#/$defs/text"}
      }
    },
    "verification_request": {
      "$comment": "Requests focused Node verification against the already reviewed artifact; models cannot select another environment or supply shell commands.",
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_ids", "criterion_ids", "test_paths", "scope", "reason", "artifact_id", "commit_sha", "source_revision"],
      "properties": {
        "finding_ids": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "pattern": "^REV-[1-9][0-9]*$"}},
        "criterion_ids": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"}},
        "test_paths": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "maxLength": 300, "pattern": "^(backend/tests|ui/nextjs/tests)/[A-Za-z0-9_./-]+\\.test\\.[cm]?[jt]sx?$"}},
        "scope": {"enum": ["ticket", "regression"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "artifact_id": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
        "source_revision": {"type": "string", "minLength": 1}
      }
    }
  }
}
