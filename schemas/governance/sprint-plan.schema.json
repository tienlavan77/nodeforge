{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/schemas/governance/sprint-plan.schema.json",
  "title": "Forge Governance Sprint Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "roadmap_id", "project_id", "objective", "tickets", "exit_criteria"],
  "properties": {
    "id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "roadmap_id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "project_id": { "$ref": "../core/common.schema.json#/$defs/id" },
    "objective": { "type": "string", "minLength": 1 },
    "human_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "in_scope", "out_of_scope", "approach", "components", "risks", "assumptions", "open_questions", "evidence_refs", "acceptance_criteria"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "in_scope": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
        "out_of_scope": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
        "approach": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }] },
        "components": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "open_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decision_requests": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "reason", "ticket_ids", "criterion_ids", "options", "recommended_option_id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
              "title": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "ticket_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "criterion_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" } },
              "recommended_option_id": { "type": ["string", "null"] },
              "options": {
                "type": "array", "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "label", "description"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                    "label": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "dependencies": { "type": "array", "items": { "$ref": "../core/common.schema.json#/$defs/id" }, "uniqueItems": true },
    "tickets": { "type": "array", "items": { "$ref": "ticket.schema.json" }, "minItems": 1 },
    "exit_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
