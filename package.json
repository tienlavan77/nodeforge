{
  "name": "nodeforge",
  "version": "0.1.0",
  "private": true,
  "description": "NodeForge workspace orchestration",
  "type": "module",
  "bin": {
    "forge": "backend/src/transport/cli/index.js"
  },
  "scripts": {
    "dev:web:vps": "node backend/scripts/start-web-vps.mjs",
    "dev:node": "node backend/scripts/start-control-api.mjs",
    "dev:foreground": "node backend/scripts/dev-foreground.mjs",
    "dev:watcher:foreground": "node backend/scripts/start-project-watcher.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js --rulesdir eslint-rules \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"backend/tests/**/*.mjs\" \"backend/scripts/**/*.mjs\" \"eslint-rules/*.js\" --no-error-on-unmatched-pattern --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --project jsconfig.json",
    "test": "node --test",
    "bootstrap:smoke": "node backend/scripts/bootstrap-smoke.mjs",
    "validate:schemas": "node backend/scripts/validate-schemas.mjs",
    "postinstall": "node backend/scripts/repair-npm-bin-links.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "typescript": "^7.0.2"
  }
}
