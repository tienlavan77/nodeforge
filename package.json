{
  "name": "nodeforge",
  "version": "0.1.0",
  "private": true,
  "description": "NodeForge workspace orchestration",
  "type": "module",
  "bin": {
    "forge": "backend/src/transport/cli/index.js"
  },
  "scripts": {
    "dev": "node backend/scripts/dev-workspace.mjs",
    "dev:web": "node ./node_modules/vite/bin/vite.js --config ui/vite.config.js",
    "dev:web:vps": "node backend/scripts/start-web-vps.mjs",
    "dev:node": "node backend/scripts/start-control-api.mjs",
    "dev:forge": "node backend/scripts/dev-forge.mjs",
    "dev:forge:stop": "node backend/scripts/dev-forge.mjs --stop",
    "dev:forge:restart": "node backend/scripts/dev-forge.mjs --restart",
    "dev:forge:api:start": "node backend/scripts/dev-forge-processes.mjs api:start",
    "dev:forge:api:stop": "node backend/scripts/dev-forge-processes.mjs api:stop",
    "dev:forge:api:restart": "node backend/scripts/dev-forge-processes.mjs api:restart",
    "dev:forge:vite:start": "node backend/scripts/dev-forge-processes.mjs vite:start",
    "dev:forge:vite:stop": "node backend/scripts/dev-forge-processes.mjs vite:stop",
    "dev:forge:vite:restart": "node backend/scripts/dev-forge-processes.mjs vite:restart",
    "dev:forge:start": "node backend/scripts/dev-forge-processes.mjs start",
    "dev:forge:shutdown": "node backend/scripts/dev-forge-processes.mjs shutdown",
    "dev:watcher": "node backend/scripts/start-project-watcher.mjs",
    "build:web": "node ./node_modules/vite/bin/vite.js build --config ui/vite.config.js",
    "lint": "node node_modules/eslint/bin/eslint.js \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"ui/src/**/*.js\" --no-error-on-unmatched-pattern --max-warnings=0",
    "typecheck": "node node_modules/typescript/bin/tsc --project jsconfig.json",
    "test": "node --test",
    "bootstrap:smoke": "node backend/scripts/bootstrap-smoke.mjs",
    "validate:schemas": "node backend/scripts/validate-schemas.mjs",
    "postinstall": "node backend/scripts/repair-npm-bin-links.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
