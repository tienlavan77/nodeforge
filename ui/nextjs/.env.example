# Control API origin used by the restart-safe UI proxy (HTTP and SSE).
NODE_CONTROL_API_URL=http://localhost:3100
# Allow synchronous Architecture planning to finish before the Next proxy times out.
# Default: NODE_SDK_AGENT_TIMEOUT_MS (3600000 when unset) plus 60000 milliseconds.
NODE_CONTROL_API_PROXY_TIMEOUT_MS=3660000
# Browsers use the same-origin proxy by default; port 3100 need not be publicly accessible.
# Set NEXT_PUBLIC_NODE_CONTROL_API_URL only when an explicit browser-facing API origin is required.
